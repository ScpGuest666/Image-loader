-- Helper: Check if block is a rod
local function isRod(part)
    if not part or not part:IsA("BasePart") then return false end
    local s = part.Size
    local d = {s.X, s.Y, s.Z}
    table.sort(d)
    return math.abs(d[1] - 0.5) < 0.05 and math.abs(d[2] - 0.5) < 0.05
end

-- Helper: Clear Visuals
local function clearAll()
    for part, hl in pairs(highlightStorage) do
        if hl then hl:Destroy() end
    end
    highlightStorage = {}
    selectedOrder = {}
    if centerBlock then centerBlock:Destroy() end
    centerBlock = nil
end

-- Helper: Toggle Outline (Occluded)
local function toggleHighlight(part)
    if highlightStorage[part] then
        highlightStorage[part]:Destroy()
        highlightStorage[part] = nil
        for i, p in ipairs(selectedOrder) do
            if p == part then table.remove(selectedOrder, i) break end
        end
    else
        local hl = Instance.new("Highlight")
        hl.FillTransparency = 1 
        hl.OutlineColor = Color3.fromRGB(255, 255, 255)
        hl.DepthMode = Enum.HighlightDepthMode.Occluded
        hl.Adornee = part
        hl.Parent = part
        highlightStorage[part] = hl
        table.insert(selectedOrder, part)
    end
end

-- Logic: 3D Best-Fit Orientation
local function calculateCenter()
    if #selectedOrder < 3 then 
        print("Select at least 3 rods for 3D alignment")
        return 
    end

    -- 1. Calculate Average Position (The Center of the hole)
    local sumPos = Vector3.new(0,0,0)
    for _, p in ipairs(selectedOrder) do sumPos = sumPos + p.Position end
    local centerPos = sumPos / #selectedOrder

    -- 2. Calculate the Normal (The "Up" direction of the curved surface)
    local p1 = selectedOrder[1].Position
    local p2 = selectedOrder[2].Position
    local p3 = selectedOrder[3].Position
    
    local v1 = (p2 - p1).Unit
    local v2 = (p3 - p1).Unit
    local normal = v1:Cross(v2).Unit
    
    -- 3. Align the block's "Right" axis to point directly at the first rod
    -- This ensures the block's edges/faces are square with the frame
    local right = (p1 - centerPos).Unit
    local back = right:Cross(normal).Unit
    local finalCFrame = CFrame.fromMatrix(centerPos, right, normal, back)

    if centerBlock then centerBlock:Destroy() end
    
    centerBlock = Instance.new("Part")
    centerBlock.Size = Vector3.new(0.5, 0.5, 0.5)
    centerBlock.Color = Color3.fromRGB(180, 0, 255)
    centerBlock.Material = Enum.Material.SmoothPlastic -- NO GLOW
    centerBlock.Transparency = 0.5 
    centerBlock.Anchored = true
    centerBlock.CanCollide = true
    centerBlock.CFrame = finalCFrame
    centerBlock.Parent = workspace
    centerBlock.Name = "BABFT_3D_Ref"
    
    local sb = Instance.new("SelectionBox")
    sb.Adornee = centerBlock
    sb.Color3 = Color3.fromRGB(255, 255, 255)
    sb.LineThickness = 0.01
    sb.Parent = centerBlock
end

-- Input Listener
inputConnection = UserInputService.InputBegan:Connect(function(input, processed)
    if processed or not scriptEnabled then return end
    
    if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
        local target = mouse.Target
        local now = tick()
        
        if target and isRod(target) then
            if target == lastTarget and (now - lastClickTime) < 0.5 then
                toggleHighlight(target)
                lastClickTime = 0
            else
                lastClickTime = now
                lastTarget = target
            end
        end
    end
end)

